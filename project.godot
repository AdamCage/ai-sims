; AI Sims — closed-block vertical slice.
config_version=5

[application]
config/name="AI Sims — Closed Block"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=940
window/size/window_width_override=1440
window/size/window_height_override=940
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.065, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
